<?xml version="1.0" encoding="UTF-8"?>
<workflow-descriptor name="Migrated Project Workflow">
  <meta name="jira.description">Bootstrap workflow for project-to-project migration</meta>
  <initial-actions>
    <action id="1" name="Create">
      <results>
        <unconditional-result old-status="null" status="open" step="1"/>
      </results>
    </action>
  </initial-actions>
  <steps>
    <step id="1" name="Open">
      <meta name="jira.status.id">1</meta>
      <actions>
        <action id="2" name="Close">
          <results>
            <unconditional-result old-status="open" status="done" step="2"/>
          </results>
        </action>
      </actions>
    </step>
    <step id="2" name="Done">
      <meta name="jira.status.id">2</meta>
    </step>
  </steps>
</workflow-descriptor>
