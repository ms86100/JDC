exports[`Storyshots Components/Rating Custom 1`] = `
<div>
  <div
    aria-label="Set your mood"
    class="ds-rating"
    role="radiogroup"
  >
    <button
      aria-checked="false"
      aria-label="Crying"
      class="ds-rating-item"
      role="radio"
      tabindex="0"
      type="button"
    >
      <div>
        <div
          style="font-size: 2rem; opacity: 0.7;"
        >
          😭
        </div>
      </div>
    </button>
    <button
      aria-checked="false"
      aria-label="Sad"
      class="ds-rating-item"
      role="radio"
      tabindex="-1"
      type="button"
    >
      <div>
        <div
          style="font-size: 2rem; opacity: 0.7;"
        >
          😞
        </div>
      </div>
    </button>
    <button
      aria-checked="false"
      aria-label="Smiling"
      class="ds-rating-item"
      role="radio"
      tabindex="-1"
      type="button"
    >
      <div>
        <div
          style="font-size: 2rem; opacity: 0.7;"
        >
          😬
        </div>
      </div>
    </button>
    <button
      aria-checked="false"
      aria-label="Happy"
      class="ds-rating-item"
      role="radio"
      tabindex="-1"
      type="button"
    >
      <div>
        <div
          style="font-size: 2rem; opacity: 0.7;"
        >
          🙂
        </div>
      </div>
    </button>
    <button
      aria-checked="false"
      aria-label="Super Happy"
      class="ds-rating-item"
      role="radio"
      tabindex="-1"
      type="button"
    >
      <div>
        <div
          style="font-size: 2rem; opacity: 0.7;"
        >
          😁
        </div>
      </div>
    </button>
  </div>
</div>
`;

