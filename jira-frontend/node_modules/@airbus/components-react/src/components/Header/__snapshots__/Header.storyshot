</div>
`;

exports[`Storyshots Components/Header Basic 1`] = `
<div>
  <div
    class="ds-header"
  >
    <div
      class="ds-header-logo"
    />
    <h1
      class="ds-header-appname"
    >
      App Name
    </h1>
    <ul
      aria-label="navigation"
      class="ds-tabs ds-tabs--floating"
      role="tablist"
    >
      <li
        role="presentation"
      >
        <a
          aria-selected="true"
          class="ds-tab ds-tab--selected ds-tab--negative"
          role="tab"
          tabindex="0"
        >
          Tab Label
        </a>
      </li>
      <li
        role="presentation"
      >
        <a
          aria-selected="false"
          class="ds-tab ds-tab--negative"
          role="tab"
          tabindex="-1"
        >
          Tab Label
        </a>
      </li>
      <li
        role="presentation"
      >
        <a
          aria-selected="false"
          class="ds-tab ds-tab--negative"
          role="tab"
          tabindex="-1"
        >
          Tab Label
        </a>
      </li>
    </ul>
  </div>
</div>
`;

