{
  "name": "@airbus/components-react",
  "author": "design-system@airbus.com",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Airbus Design System - react components",
  "version": "3.8.0",
  "main": "dist/index.js",
  "module": "dist/index.es.js",
  "jsnext:main": "dist/index.es.js",
  "files": [
    "src",
    "!src/_visualregression_",
    "!src/demo",
    "!src/doc",
    "!src/**/__snapshots__",
    "dist",
    "storybook-static",
    "LICENSE.md",
    "telemetry.yml"
  ],
  "scripts": {
    "start": "echo start",
    "build": "rollup -c && node scripts/post-build.js",
    "format": "prettier -l ./src",
    "format:fix": "prettier -w ./src",
    "lint": "NODE_ENV=development eslint ./src",
    "lint:fix": "NODE_ENV=development eslint --fix ./src",
    "test-ts": "tsc --noEmit",
    "test": "node scripts/test.js",
    "test-snap": "npm run test -- --maxWorkers=50% --testMatch=**/storybook-snap.test.ts",
    "test-full": "npm run test -- --ci --coverage --reporters=default --reporters=jest-junit",
    "test:coverage": "npm run test -- --coverage --watchAll=false",
    "static-storybook": "node scripts/static-storybook.js",
    "test-visual-airbus": "wait-on tcp:127.0.0.1:$PORT && ADS_VISUAL_BRAND=airbus test-storybook --url http://127.0.0.1:$PORT --junit",
    "test-visual-skywise": "wait-on tcp:127.0.0.1:$PORT && ADS_VISUAL_BRAND=skywise test-storybook --url http://127.0.0.1:$PORT --junit",
    "test-visual-airbus:ci": "PORT=3000 concurrently --success command-testab  --names server,testab --kill-others \"npm:static-storybook\" \"npm:test-visual-airbus\"",
    "test-visual-skywise:ci": "PORT=3001 concurrently --success command-testsk --names server,testsk --kill-others \"npm:static-storybook\" \"npm:test-visual-skywise\"",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "build-storybook:ci": "storybook build --test",
    "pack": "npm pack"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.1",
    "react": "^18.0.0 || ^19.0.4",
    "react-dom": "^18.0.0 || ^19.0.4"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "dependencies": {
    "@airbus/dayzed": "3.2.3-airbuspatch.1",
    "@airbus/design-tokens": "^3.8.0",
    "@airbus/icons": "3.0.3",
    "@airbus/styles": "^3.8.0",
    "@airbus/telemetry-js": "1.10.2-fork.1",
    "@floating-ui/react": "0.27.6",
    "@tanstack/react-table": "8.21.2",
    "clsx": "2.1.1",
    "downshift": "9.0.13",
    "jss": "10.10.0",
    "jss-preset-default": "10.10.0",
    "lodash.range": "3.2.0",
    "match-sorter": "8.2.0",
    "motion": "^12.10.5",
    "react-window": "1.8.11"
  },
  "devDependencies": {
    "@airbus/storybook-addon-posthog": "~0.1.3",
    "@babel/core": "~7.22.20",
    "@babel/preset-env": "~7.22.20",
    "@babel/preset-react": "~7.22.5",
    "@babel/preset-typescript": "~7.22.15",
    "@jest/globals": "^29.7.0",
    "@material-design-icons/svg": "0.14.15",
    "@rollup/plugin-typescript": "~11.1.6",
    "@rollup/plugin-url": "~8.0.2",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-actions": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-links": "8.6.14",
    "@storybook/addon-themes": "8.6.14",
    "@storybook/addon-viewport": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/builder-vite": "8.6.14",
    "@storybook/manager-api": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/test-runner": "^0.21.3",
    "@storybook/theming": "8.6.14",
    "@testing-library/jest-dom": "~6.1.3",
    "@testing-library/react": "~14.0.0",
    "@testing-library/user-event": "~14.4.3",
    "@types/css-mediaquery": "~0.1.2",
    "@types/jest": "~29.5.5",
    "@types/jest-axe": "~3.5.9",
    "@types/jest-image-snapshot": "^6.4.0",
    "@types/lodash.range": "~3.2.6",
    "@types/mdx": "~2.0.7",
    "@types/node": "^20.10.0",
    "@types/react": "~18.2.22",
    "@types/react-dom": "~18.2.0",
    "@types/react-table": "~7.7.15",
    "@types/react-window": "~1.8.8",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "babel-jest": "~29.7.0",
    "browserslist": "~4.21.11",
    "concurrently": "^9.1.2",
    "css-mediaquery": "~0.1.2",
    "dotenv": "~16.3.0",
    "dotenv-expand": "~10.0.0",
    "eslint": "~8.48.0",
    "eslint-config-prettier": "~9.0.0",
    "eslint-config-react-app": "~7.0.1",
    "final-form": "~4.20.10",
    "glightbox": "~3.3.0",
    "http-server": "^14.1.1",
    "jest": "~29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "~29.7.0",
    "jest-image-snapshot": "^6.4.0",
    "jest-junit": "~16.0.0",
    "jest-specific-snapshot": "^8.0.0",
    "jest-watch-typeahead": "~2.2.2",
    "lodash.orderby": "~4.6.0",
    "prettier": "~3.0.3",
    "react": "~18.2.0",
    "react-docgen-typescript": "~2.2.2",
    "react-dom": "~18.2.0",
    "react-final-form": "~6.5.9",
    "react-jss": "~10.10.0",
    "react-router-dom": "~6.15.0",
    "reassure": "^1.4.0",
    "remark-gfm": "^4.0.0",
    "rollup": "^4.24.4",
    "rollup-plugin-sizes": "~1.0.6",
    "rollup-plugin-visualizer": "~5.9.3",
    "storybook": "8.6.14",
    "tslib": "^2.7.0",
    "typescript": "^5.7.2",
    "use-local-storage-state": "~18.3.3",
    "vite": "^5.4.11",
    "vite-plugin-svgr": "^4.3.0",
    "wait-on": "^8.0.3"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 10",
    "not op_mini all"
  ],
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "ignorePatterns": [
      "rollup.config.mjs"
    ],
    "rules": {
      "import/no-anonymous-default-export": "off"
    }
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "collectCoverageFrom": [
      "src/components/**/*.{ts,tsx}",
      "src/lib/hooks/*.{ts,tsx}",
      "src/lib/utils/*.{ts,tsx}",
      "!**/*.stories.{ts,tsx}",
      "!**/node_modules/**",
      "!**/coverage/**"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "testMatch": [
      "<rootDir>/src/!(_visualregression_)/**/*.{spec,test}.{js,jsx,ts,tsx}",
      "<rootDir>/src/storybook-snap.test.ts"
    ],
    "moduleNameMapper": {
      "\\.svg": "<rootDir>/config/jest/svg.js"
    },
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(js|jsx|mjs|cjs|ts|tsx)$": "<rootDir>/config/jest/babelTransform.js",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|mjs|cjs|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|mjs|cjs|ts|tsx)$"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ],
    "resetMocks": true
  },
  "jest-junit": {
    "classNameTemplate": "react.{classname}.{title}",
    "outputDirectory": "./reports",
    "outputName": "junit.xml"
  }
}
