{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "baseUrl": "src",
    "declaration": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "importHelpers": true,
    "jsx": "react-jsx",
    "lib": ["dom", "es2015", "es2016", "es2017", "ES2019"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "outDir": "dist",
    "rootDirs": ["src"],
    "sourceMap": true,
    "strictNullChecks": true,
    "target": "es5",
    "types": [
      "@testing-library/jest-dom", 
      "@types/mdx",
      "@types/react",
      "vite/client",
      "@types/node",
      "jest",
      "react"
    ]
  },
  "include": ["src/**/*", "src/**/*.stories.jsx"]
}
