{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "es2015",
    "skipLibCheck": true,
    "outDir": "./dist/module"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.stories.*",
    "**/*.doc.mdx",
    "**/*.config.ts",
    "**/*.config.js",
    "vite.config.ts"
  ]
}
