{
  "name": "@airbus/styles",
  "author": "design-system@airbus.com",
  "license": "SEE LICENSE IN LICENSE",
  "version": "3.8.0",
  "description": "Airbus Design System - CSS classes",
  "main": "dist/commonjs/index.js",
  "module": "dist/module/index.js",
  "jsnext:main": "dist/module/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.airbus.corp/Airbus/design-system.git"
  },
  "files": [
    "src",
    "!src/doc",
    "!src/**/__snapshots__",
    "dist",
    "storybook-static",
    "LICENSE.md"
  ],
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 10",
    "not op_mini all"
  ],
  "scripts": {
    "test": "jest --watch",
    "test-full": "jest --reporters=default --reporters=jest-junit --coverage --ci --verbose",
    "build:variabilized-stylesheet": "npx ts-node scripts/generateVariabilizedStylesheets.ts",
    "build": "concurrently \"npm run build:stylesheet\" \"npm run build:module\" \"npm run build:commonjs\"",
    "build:stylesheet": "npx ts-node -O '{\"module\":\"CommonJS\"}' scripts/generateStylesheets.ts",
    "build:module": "tsc -p tsconfig.module.json",
    "build:commonjs": "tsc -p tsconfig.commonjs.json",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "watch": "nodemon --watch 'src' --ignore 'src/icons/*.ts' --ext 'ts' --exec \"npm run build\"",
    "start-storybook": "sb dev -p 6006",
    "clear-storybook": "sb dev --no-cache -p 6006",
    "build-storybook": "sb build",
    "storybook": "concurrently \"npm run watch\" \"npm run start-storybook\"",
    "kpi:tokens": "npx ts-node scripts/getTokensUsage.ts",
    "pack": "npm pack"
  },
  "dependencies": {
    "@airbus/design-tokens": "^3.8.0",
    "@airbus/icons": "3.0.3",
    "polished": "4.2.2"
  },
  "devDependencies": {
    "@airbus/storybook-addon-posthog": "~0.1.3",
    "@babel/core": "~7.22.20",
    "@babel/preset-env": "~7.22.20",
    "@babel/preset-react": "~7.22.5",
    "@babel/preset-typescript": "~7.22.15",
    "@fontsource/material-icons": "^5.1.1",
    "@mdx-js/react": "^3.1.1",
    "@storybook/addon-a11y": "8.6.14",
    "@storybook/addon-actions": "8.6.14",
    "@storybook/addon-docs": "8.6.14",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-links": "8.6.14",
    "@storybook/addon-themes": "8.6.14",
    "@storybook/addon-viewport": "8.6.14",
    "@storybook/blocks": "8.6.14",
    "@storybook/builder-vite": "^8.6.14",
    "@storybook/cli": "^8.6.14",
    "@storybook/manager-api": "8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/theming": "8.6.14",
    "@types/css": "~0.0.34",
    "@types/cssnano": "~5.1.0",
    "@types/fs-extra": "~11.0.2",
    "@types/jest": "~29.5.5",
    "@types/mdx": "~2.0.7",
    "@types/node": "^20.10.0",
    "@types/react": "~18.2.22",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "~10.4.16",
    "babel-jest": "~29.7.0",
    "babel-loader": "~9.1.3",
    "concurrently": "~8.2.1",
    "css": "~3.0.0",
    "cssnano": "~6.0.1",
    "csstype": "~3.1.2",
    "fs-extra": "~11.1.1",
    "jest": "~29.7.0",
    "jest-junit": "~16.0.0",
    "jss": "~10.10.0",
    "jss-preset-default": "~10.10.0",
    "nodemon": "~3.0.0",
    "postcss": "~8.4.30",
    "react": "~18.2.0",
    "react-dom": "~18.2.0",
    "remark-gfm": "^4.0.0",
    "ts-node": "~10.9.1",
    "tslib": "~2.6.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vite-plugin-svgr": "^4.3.0"
  },
  "jest-junit": {
    "classNameTemplate": "styles.{classname}.{title}",
    "outputDirectory": "./reports",
    "outputName": "junit.xml"
  }
}
