# =============================================================================
# Docker Build Ignore Patterns
# Excludes unnecessary files from Docker build context to reduce image size
# and speed up builds
# =============================================================================

# Version Control
.git
.gitignore
.gitattributes

# IDE and Editor Files
.idea
.vscode
*.iml
*.iws
*.ipr
.project
.classpath
.settings/

# Build Artifacts
*.class
*.jar
*.war
*.ear

# Log Files
*.log
logs/
**/logs/
*.log.*

# Environment and Configuration (secrets should be passed via env vars)
.env
.env.*
.env.local
.env.*.local

# Documentation (reduces build context size)
*.md
README*
LICENSE
docs/
*.txt

# Node.js (frontend builds)
node_modules/
npm-debug.log
yarn-error.log
.yarn/
.pnp.*

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.coverage
*.egg-info/

# Maven
.m2/
.mvn/
*.bak

# Temporary and Cache Files
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local Development Files
docker-compose*.yml
*.sh

# Dependency Cache (needed for cross-service builds)
.dependency-jars/
# Note: .m2-cache/ is intentionally NOT ignored — needed for offline Maven build of migration-service

# Test Files
test-results/
surefire-reports/

# Exception: include everything in .m2-cache for offline Maven builds (must be last to override *.jar exclusion)
!.m2-cache/**
!.m2-cache