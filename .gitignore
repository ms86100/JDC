# Platform Runtime (generated at runtime)
platform-runtime/
logs/
*.log
hs_err_pid*.log
replay_pid*.log

# Python
__pycache__/
*.py[cod]
*$py.class
.Python

# Java build outputs
jira-*/target/
*.class
*.jar
*.war
*.ear

# Vite build output
jira-frontend/dist/

# Playwright browser cache (postinstall)
jira-frontend/.cache/
jira-frontend/test-results/
jira-frontend/node_modules/.vite/

# Node modules (never commit — use npm ci in jira-frontend)
jira-frontend/node_modules/
platform-runtime/node_modules/
**/node_modules/

# IDE
.idea/
*.iml
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Temporary / local-only
*.tmp
*.bak
*.backup
*.temp
plan-*.txt
test-*.sh
.claude/

# Archived one-off reports (source copies live under docs/)
docs/archive/

# Credentials (DO NOT COMMIT)
*.env
*.env.local
*.env.*.local
*.pem
*.key
credentials.json
secrets.json

# Build artifacts
*.jar.original

# Environment files
.env.local
.env.production
