FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /build

COPY .m2-cache /root/.m2/repository
COPY avionics-systems-migration-service/netskope-ca.cer /tmp/netskope-ca.cer
RUN keytool -importcert -noprompt -alias netskope-ca \
    -file /tmp/netskope-ca.cer \
    -keystore /usr/local/openjdk-21/lib/security/cacerts \
    -storepass changeit || true

COPY avionics-systems-admin-service/pom.xml .
COPY avionics-systems-admin-service/src ./src

RUN mvn package -Dmaven.test.skip=true -q

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S appuser && adduser -S appuser -G appuser
COPY --from=builder /build/target/*.jar app.jar
RUN chown -R appuser:appuser /app
USER appuser
EXPOSE 8093
ENTRYPOINT ["java","-jar","app.jar"]
