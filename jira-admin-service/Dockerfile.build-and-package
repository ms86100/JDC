FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /build

COPY .m2-cache /root/.m2/repository
COPY jira-migration-service/netskope-ca.cer /tmp/netskope-ca.cer
RUN keytool -importcert -noprompt -alias netskope-ca \
    -file /tmp/netskope-ca.cer \
    -keystore /usr/local/openjdk-21/lib/security/cacerts \
    -storepass changeit || true

COPY jira-admin-service/pom.xml .
COPY jira-admin-service/src ./src

RUN mvn package -Dmaven.test.skip=true -q

FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
RUN addgroup -S jira && adduser -S jira -G jira
COPY --from=builder /build/target/*.jar app.jar
RUN chown -R jira:jira /app
USER jira
EXPOSE 8093
ENTRYPOINT ["java","-jar","app.jar"]
