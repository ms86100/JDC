<html>
<head>
    <title>Test Execution History</title>
</head>
<body>
    <div class="execution-history">
        <h2>Test Execution History</h2>
        <div class="history-chart">
            <!-- Chart placeholder -->
        </div>
        <table class="history-table">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Duration</th>
                    <th>Executor</th>
                </tr>
            </thead>
            <tbody>
                #foreach($execution in $history)
                <tr class="execution-$execution.status">
                    <td>$execution.date</td>
                    <td>$execution.status</td>
                    <td>${execution.duration}s</td>
                    <td>$execution.executor</td>
                </tr>
                #end
            </tbody>
        </table>
    </div>
</body>
</html>